VITE_SUPABASE_URL=
# The public (anon / "publishable") key. Never the service-role / secret key.
VITE_SUPABASE_ANON_KEY=
# Your live site address, e.g. https://yunus.dev. Used for canonical URLs, social cards and
# sitemap.xml. On Vercel it falls back to the production domain if left empty.
VITE_SITE_URL=
